<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>ragfoundry</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ragfoundry-core</artifactId>
  <name>ragfoundry-core</name>
  <description>RAG 原语核心：切片 / 嵌入抽象 / 内存向量检索 / 检索管线。零第三方运行期依赖。</description>

  <properties>
    <!-- core 是纯逻辑，覆盖门禁收紧到 0.80 -->
    <jacoco.line.minimum>0.80</jacoco.line.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>ragfoundry-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- core 的 RetrieverTest 端到端集成测试需要真实的 VectorStore 实现，故以 test 作用域依赖 store，避免生产代码反向依赖存储实现 -->
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>ragfoundry-store</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

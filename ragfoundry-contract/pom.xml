<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>ragfoundry</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ragfoundry-contract</artifactId>
  <name>ragfoundry-contract</name>
  <description>RAG 共享契约：值对象（Document / TextChunk / ScoredChunk / ScoredId / Embedding）、异常（DimensionMismatchException）与核心接口（ChunkingStrategy / EmbeddingModel / VectorStore）。零运行期依赖，被 core 与 store 共同依赖。</description>

  <properties>
    <!-- contract 是纯值对象与接口，覆盖门禁收紧到 0.70 -->
    <jacoco.line.minimum>0.70</jacoco.line.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>

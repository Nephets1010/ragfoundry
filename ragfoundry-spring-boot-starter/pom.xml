<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nephets</groupId>
    <artifactId>ragfoundry</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>ragfoundry-spring-boot-starter</artifactId>
  <name>ragfoundry-spring-boot-starter</name>
  <description>Spring Boot 自动装配：开箱即用的 EmbeddingModel / VectorStore / Retriever。</description>

  <properties>
    <jacoco.line.minimum>0.70</jacoco.line.minimum>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.nephets</groupId>
      <artifactId>ragfoundry-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
